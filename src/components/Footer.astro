---
import { useTranslations } from "@/i18n/utils";
import type { Lang } from "@/i18n/ui";
import { profile } from "@/data/about";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-box">
      <p class="footer-name">Tara Rose Morris</p>
      <p class="footer-tag muted">{t("footer.tagline")}</p>
    </div>
    <div class="footer-box footer-contact">
      <span class="footer-contact-label">{t("footer.contact")}:</span>
      <div class="footer-contact-icons">
        <a
          class="footer-icon"
          href={`mailto:${profile.email}`}
          aria-label={`Email ${profile.email}`}
          title={profile.email}
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="5" width="18" height="14" rx="2" />
            <path d="m3 7 9 6 9-6" />
          </svg>
        </a>
        {
          profile.instagram && (
            <a
              class="footer-icon"
              href={profile.instagram}
              target="_blank"
              rel="noopener"
              aria-label="Instagram"
              title="Instagram"
            >
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="3" y="3" width="18" height="18" rx="5" />
                <circle cx="12" cy="12" r="4" />
                <circle cx="17.5" cy="6.5" r="0.8" fill="currentColor" />
              </svg>
            </a>
          )
        }
      </div>
    </div>
    <div class="footer-box footer-copy muted">
      © {year} Tara Rose Morris. {t("footer.rights")}
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: var(--border);
    background: var(--bg-elevated);
    margin-top: auto;
    padding: 0 var(--pad-x) clamp(1.5rem, 3vw, 2rem);
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 0;
    border-inline: var(--border);
    border-bottom: var(--border);
    max-width: var(--maxw);
  }
  .footer-box {
    border: var(--border);
    margin: -1px 0 0 -1px;
    padding: 1.25rem clamp(1rem, 2vw, 1.5rem);
  }
  .footer-name {
    font-family: var(--font-display);
    font-size: 1rem;
    text-transform: uppercase;
    margin: 0;
  }
  .footer-tag {
    margin: 0.35rem 0 0;
    font-size: 0.78rem;
  }
  .footer-contact {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }
  .footer-contact-label {
    font-family: var(--font-label);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .footer-contact-icons {
    display: flex;
    gap: 0.6rem;
  }
  .footer-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.1rem;
    height: 2.1rem;
    border: var(--border);
    background: #ffffff;
    color: var(--ink);
    transition: background 0.12s ease, color 0.12s ease;
  }
  .footer-icon:hover {
    background: var(--ink);
    color: #ffffff;
  }
  .footer-icon svg {
    width: 1.15rem;
    height: 1.15rem;
  }
  .footer-copy {
    grid-column: 1 / -1;
    font-size: 0.75rem;
    border-top: var(--border);
  }
  @media (max-width: 620px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
