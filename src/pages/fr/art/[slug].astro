---
import ProjectPage from "@/components/pages/ProjectPage.astro";
import { getProjects, projectSlug } from "@/lib/projects";

export async function getStaticPaths() {
  const projects = await getProjects("fr");
  return projects.map((entry) => ({
    params: { slug: projectSlug(entry) },
    props: { entry },
  }));
}

const { entry } = Astro.props;
---

<ProjectPage entry={entry} lang="fr" />
